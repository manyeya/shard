{
  "manifest_version": 3,
  "name": "Shard integration",
  "version": "0.1.0",
  "description": "Hands your downloads to the Shard app. When the app isn't running, the browser downloads as usual.",
  "permissions": [
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/shard-16.png",
    "32": "icons/shard-32.png",
    "48": "icons/shard-48.png",
    "128": "icons/shard-128.png"
  }
}
